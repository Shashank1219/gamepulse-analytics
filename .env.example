# AWS S3 (Layer 1 generator & Layer 2 landing zone)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-central-1
S3_BUCKET_NAME=gamepulse-raw

# Databricks (Layer 4 ingest, Airflow DAG & dbt)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_pat
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_WORKSPACE_ID=your_workspace_id

# dbt (Layer 5 transformation)
DBT_PROFILES_DIR=./dbt
DBT_TARGET_SCHEMA=gamepulse_dev